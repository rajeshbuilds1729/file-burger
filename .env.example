# ── File Burger configuration ────────────────────────────────────────────────
# Copy this file to `.env` (or `.env.local`) and adjust as needed.
# Everything here is optional — `npm run dev` works with zero configuration.

# HTTP + WebSocket port for the custom server.
PORT=3000

# Public base URL of the deployment. Used for metadata, QR codes and share links.
# In development the app falls back to the current browser origin.
NEXT_PUBLIC_SITE_URL=

# ── ICE / TURN ───────────────────────────────────────────────────────────────
# STUN servers are always included by default.
# Optional TURN relay for peers that cannot establish a direct connection.
# NOTE: with static TURN credentials, anyone using the site can read them from
# this configuration (they are served to the browser). Use short-lived
# credentials (e.g. coturn `use-auth-secret` with a REST API) for production.
# JSON array of TURN URL strings, e.g.:
NEXT_PUBLIC_TURN_URLS=["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp"]
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=

# ── Redis (optional) ─────────────────────────────────────────────────────────
# When set, ephemeral transfer/session metadata is stored in Redis instead of
# in-process memory. File contents are NEVER stored anywhere.
# NEXT_PUBLIC_REDIS_URL= is not required; only the server needs this.
REDIS_URL=

# ── Signaling transport ──────────────────────────────────────────────────────
# "auto" (default) probes WebSocket first and falls back to HTTP polling.
# On serverless hosts without WebSocket support (e.g. Vercel), set this to
# "http" to skip the probe.
# NEXT_PUBLIC_SIGNALING_TRANSPORT=auto

# ── Sessions ─────────────────────────────────────────────────────────────────
# Transfer sessions auto-expire after this many hours (1–72).
SESSION_TTL_HOURS=6

# Comma-separated list of extra origins allowed to open the WebSocket
# signaling connection. Same-origin is always allowed.
ALLOWED_ORIGINS=
