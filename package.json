{
  "name": "file-burger",
  "version": "1.0.0",
  "private": true,
  "description": "Private peer-to-peer file sharing directly between browsers. No account. No upload queue. Just send.",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch server/server.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx server/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "client-zip": "^2.5.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "framer-motion": "^13.4.5",
    "ioredis": "^6.0.0",
    "js-sha256": "^1.0.0",
    "lucide-react": "^1.48.0",
    "next": "^15.5.26",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
